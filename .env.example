# Core
APP_ENV=development
LOG_LEVEL=INFO

# Infrastructure
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=jabrig
POSTGRES_USER=jabrig
POSTGRES_PASSWORD=jabrig
REDIS_URL=redis://localhost:6379/0

# Model providers
OPENAI_API_KEY=your_openai_api_key
NINEROUTER_API_KEY=your_ninerouter_api_key
NINEROUTER_BASE_URL=http://localhost:20128/v1
NINEROUTER_DEFAULT_MODEL=gpt-oss-20b
OPENROUTER_API_KEY=your_openrouter_api_key
OPENROUTER_DEFAULT_MODEL=openai/gpt-oss-20b
JABRIG_API_KEY=test-key
